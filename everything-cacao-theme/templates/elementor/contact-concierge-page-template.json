              "settings": {
                "html": "<section class=\"py-16 bg-[#FAF7F2]\">\n  <div class=\"max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-2 gap-12\">\n    <div class=\"p-8 bg-[#F5EDE4] rounded-2xl border border-[#1A0F0A]/10 space-y-6\">\n      <h2 class=\"font-serif-luxury text-2xl font-bold text-[#1A0F0A]\">Accra Showroom & HQ</h2>\n      <div class=\"space-y-4 text-sm text-[#5C4A3E]\">\n        <p>📍 <strong>Location:</strong> Accra, Ghana</p>\n        <p>✉️ <strong>Email:</strong> info@everythingcacaogh.com</p>\n        <p>💬 <strong>WhatsApp:</strong> +233 24 066 1866</p>\n      </div>\n    </div>\n    <div class=\"p-8 bg-[#F5EDE4] rounded-2xl border border-[#1A0F0A]/10 space-y-6\">\n      <h2 class=\"font-serif-luxury text-2xl font-bold text-[#1A0F0A]\">Send a Concierge Request</h2>\n      <form class=\"space-y-4\">\n        <input type=\"text\" placeholder=\"Full Name\" class=\"w-full p-3.5 bg-[#FAF7F2] border border-[#1A0F0A]/20 rounded-lg text-sm text-[#1A0F0A]\" />\n        <input type=\"email\" placeholder=\"Email Address\" class=\"w-full p-3.5 bg-[#FAF7F2] border border-[#1A0F0A]/20 rounded-lg text-sm text-[#1A0F0A]\" />\n        <textarea placeholder=\"How can our concierge assist you?\" rows=\"4\" class=\"w-full p-3.5 bg-[#FAF7F2] border border-[#1A0F0A]/20 rounded-lg text-sm text-[#1A0F0A]\"></textarea>\n        <button type=\"button\" class=\"w-full py-4 bg-[#1A0F0A] text-[#FAF7F2] font-bold text-xs uppercase tracking-widest hover:bg-[#C86D51] transition-colors rounded-lg\">\n          Submit Concierge Request\n        </button>\n      </form>\n    </div>\n  </div>\n</section>"
