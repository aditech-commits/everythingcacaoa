{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#FBF8F3",
          "name": "Canvas Background",
          "slug": "canvas"
        },
        {
          "color": "#FFFFFF",
          "name": "Card Surface",
          "slug": "card-bg"
        },
        {
          "color": "#2C1A11",
          "name": "Cacao Dark",
          "slug": "cacao-dark"
        },
        {
          "color": "#D4AF37",
          "name": "Accent Gold",
          "slug": "accent-gold"
        },
        {
          "color": "#C86D51",
          "name": "Accent Terracotta",
          "slug": "accent-terracotta"
        },
        {
          "color": "#E08E45",
          "name": "Cherelle Caramel",
          "slug": "cherelle-caramel"
        },
        {
          "color": "#3D281C",
          "name": "Nahar Obsidian Warm",
          "slug": "nahar-obsidian"
        },
        {
          "color": "#25D366",
          "name": "WhatsApp Green",
          "slug": "accent-whatsapp"
        },
        {
          "color": "#7A685A",
          "name": "Text Muted",
          "slug": "text-muted"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1280px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "name": "Serif Luxury (Playfair Display)",
          "slug": "serif-luxury"
        },
        {
          "fontFamily": "'Hanken Grotesk', system-ui, -apple-system, sans-serif",
          "name": "Sans Body (Hanken Grotesk)",
          "slug": "sans-body"
        }
      ],
      "fontSizes": [
        {
          "name": "Caption",
          "size": "11px",
          "slug": "xs"
        },
        {
          "name": "Small",
          "size": "13px",
          "slug": "sm"
        },
        {
          "name": "Body",
          "size": "15px",
          "slug": "md"
        },
        {
          "name": "Subtitle",
          "size": "18px",
          "slug": "lg"
        },
        {
          "name": "Heading 3",
          "size": "24px",
          "slug": "xl"
        },
        {
          "name": "Heading 2",
          "size": "36px",
          "slug": "2xl"
        },
        {
          "name": "Hero Display",
          "size": "48px",
          "slug": "3xl"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--cacao-dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-body)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif-luxury)",
          "fontWeight": "700"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif-luxury)",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif-luxury)",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--cacao-dark)"
        }
      }
    }
  }
}
